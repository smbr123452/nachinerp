// Nachin ERP-lite — нэг компани, нэг үндсэн агуулах.
// Санхүү / нөөцийн бүх өөрчлөлт нь дэвтэр (ledger) бичлэг үүсгэнэ.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  MANAGER
}

/// Хэмжих нэгж. WEIGHT (kg/g), VOLUME (l/ml) хооронд хөрвөнө.
/// COUNT (pcs/box/pack) нь хөрвөхгүй, тус тусдаа нэгж.
enum Unit {
  KG
  GRAM
  LITER
  ML
  PCS
  BOX
  PACK
}

/// Бүтээгдэхүүний төрөл.
///  MANUFACTURED — жороор үйлдвэрлэдэг (орц нь материалаас хасагдана)
///  RESALE       — худалдан авч дамжуулан борлуулдаг (өөрийн нөөцтэй)
enum ProductType {
  MANUFACTURED
  RESALE
}

/// Санхүү / нөөцийн баримтын төлөв. Устгахын оронд CANCELLED болгоно.
enum DocStatus {
  DRAFT
  POSTED
  CANCELLED
  REVERSED
}

enum MovementType {
  PURCHASE_IN
  SALE_CONSUMPTION_OUT
  MANUAL_ADJUSTMENT_IN
  MANUAL_ADJUSTMENT_OUT
  INVENTORY_COUNT_GAIN
  INVENTORY_COUNT_LOSS
  WASTE_OUT
  RETURN_IN
  INTERNAL_USE_OUT
  CORRECTION_IN
  CORRECTION_OUT
}

enum Account {
  CASH
  BANK
}

enum MoneyTransactionType {
  SALE_CASH_IN
  SALE_BANK_IN
  PURCHASE_PAYMENT_OUT
  EXPENSE_OUT
  BANK_DEPOSIT
  OWNER_ADJUSTMENT
  OTHER_IN
  OTHER_OUT
}

/// Борлуулалтын төлбөрийн хэлбэр.
enum PaymentMethod {
  CASH
  CARD
  QR
  BANK_TRANSFER
  OTHER
}

/// Худалдан авалтын төлбөрийн хэлбэр.
enum PurchasePaymentMethod {
  CASH
  BANK
  CREDIT
}

// ---------------------------------------------------------------------------
// Хэрэглэгч / нэвтрэлт
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(MANAGER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions        Session[]
  auditLogs       AuditLog[]
  purchases       Purchase[]           @relation("PurchaseCreatedBy")
  saleBatches     SaleBatch[]          @relation("SaleBatchCreatedBy")
  movements       InventoryMovement[]  @relation("MovementCreatedBy")
  expenses        Expense[]            @relation("ExpenseCreatedBy")
  moneyTxns       MoneyTransaction[]   @relation("MoneyTxnCreatedBy")
  inventoryCounts InventoryCount[]     @relation("CountCreatedBy")
  attachments     PurchaseAttachment[] @relation("AttachmentUploadedBy")
  supplierItems   SupplierItem[]       @relation("SupplierItemCreatedBy")

  @@index([isActive])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Бараа материал (түүхий эд)
// ---------------------------------------------------------------------------

model RawMaterialCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rawMaterials RawMaterial[]

  @@index([isActive])
}

model RawMaterial {
  id         String  @id @default(cuid())
  sku        String  @unique
  name       String
  categoryId String?
  /// Үндсэн нэгж — нөөц, өртөг, жор бүгд энэ нэгжээр хадгалагдана.
  unit       Unit

  quantity          Decimal  @default(0) @db.Decimal(18, 3)
  minimumStock      Decimal  @default(0) @db.Decimal(18, 3)
  /// Жигнэсэн дундаж өртөг (нэгжид).
  averageCost       Decimal  @default(0) @db.Decimal(18, 4)
  lastPurchasePrice Decimal? @db.Decimal(18, 4)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category      RawMaterialCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  movements     InventoryMovement[]
  purchaseItems PurchaseItem[]
  recipeItems   RecipeItem[]
  countItems    InventoryCountItem[]
  supplierItems SupplierItem[]

  @@index([isActive])
  @@index([categoryId])
}

// ---------------------------------------------------------------------------
// Бүтээгдэхүүн ба жор (BOM)
// ---------------------------------------------------------------------------

model ProductCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([isActive])
}

model Product {
  id           String      @id @default(cuid())
  sku          String      @unique
  name         String
  categoryId   String?
  productType  ProductType @default(MANUFACTURED)
  sellingPrice Decimal     @db.Decimal(18, 2)
  isActive     Boolean     @default(true)

  /// Дараах талбарууд ЗӨВХӨН RESALE бүтээгдэхүүнд утгатай.
  /// MANUFACTURED-ийн өртөг нь жорноос бодогддог тул эдгээр нь 0 хэвээр үлдэнэ.
  unit              Unit     @default(PCS)
  quantity          Decimal  @default(0) @db.Decimal(18, 3)
  minimumStock      Decimal  @default(0) @db.Decimal(18, 3)
  /// Жигнэсэн дундаж авалтын өртөг (нэгжид).
  averageCost       Decimal  @default(0) @db.Decimal(18, 4)
  lastPurchasePrice Decimal? @db.Decimal(18, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category      ProductCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recipeItems   RecipeItem[]
  saleItems     SaleItem[]
  movements     InventoryMovement[]
  purchaseItems PurchaseItem[]
  supplierItems SupplierItem[]

  @@index([isActive])
  @@index([categoryId])
  @@index([productType, isActive])
}

model RecipeItem {
  id            String  @id @default(cuid())
  productId     String
  rawMaterialId String
  /// Нэгж бүтээгдэхүүнд шаардагдах хэмжээ (доорх нэгжээр).
  quantity      Decimal @db.Decimal(18, 4)
  unit          Unit

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)

  @@unique([productId, rawMaterialId])
  @@index([rawMaterialId])
}

// ---------------------------------------------------------------------------
// Худалдан авалт
// ---------------------------------------------------------------------------

model Supplier {
  id            String   @id @default(cuid())
  name          String   @unique
  phone         String?
  contactPerson String?
  email         String?
  note          String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchases Purchase[]
  items     SupplierItem[]

  @@index([isActive])
}

/// Нийлүүлэгч ↔ бараа холбоос: "энэ барааг ихэвчлэн эндээс авдаг".
///
/// Энэ нь ЗӨВХӨН мастер өгөгдлийн сонголт — худалдан авалт болсон гэсэн үг
/// БИШ. Бодит үнэ ба огноо нь ҮРГЭЛЖ PurchaseItem түүхээс гарна. Тиймээс
/// энд үнэ хадгалахгүй (lastPurchasePrice, defaultPrice гэх мэт ОГТ байхгүй).
///
/// rawMaterialId / productId-ийн ЯГ НЭГ нь утгатай (DB CHECK).
/// Зөвхөн идэвхтэй түүхий эд, эсвэл идэвхтэй RESALE бүтээгдэхүүн холбогдоно —
/// үйлдвэрлэдэг бүтээгдэхүүнийг худалдаж авдаггүй.
model SupplierItem {
  id            String   @id @default(cuid())
  supplierId    String
  rawMaterialId String?
  productId     String?
  createdById   String
  createdAt     DateTime @default(now())

  supplier    Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  rawMaterial RawMaterial? @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  product     Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy   User         @relation("SupplierItemCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  /// Нэг нийлүүлэгчид нэг бараа давхардахгүй. Postgres-д NULL нь ялгаатай
  /// тул (supplierId, NULL) хос олон удаа давтагдаж болно — энэ нь зөв:
  /// нэг нийлүүлэгч олон бүтээгдэхүүнтэй байхад түүхий эдийн индекс саад болохгүй.
  @@unique([supplierId, rawMaterialId])
  @@unique([supplierId, productId])
  @@index([supplierId])
  @@index([rawMaterialId])
  @@index([productId])
}

model Purchase {
  id            String                @id @default(cuid())
  purchaseNo    String                @unique
  date          DateTime
  supplierId    String?
  paymentMethod PurchasePaymentMethod @default(CASH)
  note          String?
  totalAmount   Decimal               @default(0) @db.Decimal(18, 2)
  status        DocStatus             @default(POSTED)

  createdById String
  cancelledAt DateTime?
  cancelNote  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// Баталгаажуулалтыг давхардуулахаас хамгаалах түлхүүр.
  ///
  /// Формын хуулбар бүр нэг л түлхүүртэй. Хоёр дахин дарах, сүлжээ давтан
  /// илгээх зэрэгт ижил түлхүүртэй хүсэлт ирвэл ШИНЭ баримт үүсэхгүй,
  /// өмнө нь үүссэн баримт буцна — нөөц хоёр дахин нэмэгдэхгүй.
  ///
  /// Хуучин баримтуудад утга байхгүй тул nullable. Postgres-д NULL нь
  /// ялгаатай гэж тооцогддог учир unique индекст саад болохгүй.
  idempotencyKey String? @unique

  supplier    Supplier?            @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdBy   User                 @relation("PurchaseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items       PurchaseItem[]
  attachments PurchaseAttachment[]

  @@index([date])
  @@index([status, date])
  @@index([supplierId, status, date])
}

/// Худалдан авалтын баримт / нэхэмжлэхийн хавсралт.
/// Файл өөрөө хадгалалтын давхаргад (storage) байрлана — энд зөвхөн
/// мета мэдээлэл ба таамаглах боломжгүй storageKey хадгалагдана.
model PurchaseAttachment {
  id               String   @id @default(cuid())
  purchaseId       String
  originalFileName String
  mimeType         String
  fileSize         Int
  /// Хадгалалтын давхаарга дахь түлхүүр. Хэрэглэгчийн өгсөн нэрийг
  /// зам болгон ХЭЗЭЭ Ч ашиглахгүй.
  storageKey       String   @unique
  uploadedById     String
  uploadedAt       DateTime @default(now())

  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([purchaseId])
}

/// Худалдан авалтын мөр. Түүхий эд эсвэл RESALE бүтээгдэхүүн —
/// rawMaterialId / productId-ийн ЯГ НЭГ нь утгатай (DB CHECK).
model PurchaseItem {
  id            String  @id @default(cuid())
  purchaseId    String
  rawMaterialId String?
  productId     String?
  /// Бичсэн нэгжээрх тоо хэмжээ ба нэгж үнэ.
  quantity      Decimal @db.Decimal(18, 3)
  unit          Unit
  unitPrice     Decimal @db.Decimal(18, 4)
  subtotal      Decimal @db.Decimal(18, 2)
  /// Материалын үндсэн нэгж рүү хөрвүүлсэн утга.
  baseQuantity  Decimal @db.Decimal(18, 3)
  baseUnitCost  Decimal @db.Decimal(18, 4)

  purchase    Purchase     @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  rawMaterial RawMaterial? @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)
  product     Product?     @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
  @@index([rawMaterialId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Борлуулалт
// ---------------------------------------------------------------------------

model SaleBatch {
  id      String    @id @default(cuid())
  batchNo String    @unique
  date    DateTime
  status  DocStatus @default(POSTED)
  note    String?
  /// POS импорт нэмэгдэхэд эх сурвалжийг ялгах талбар.
  source  String    @default("MANUAL")

  totalRevenue Decimal @default(0) @db.Decimal(18, 2)
  totalCogs    Decimal @default(0) @db.Decimal(18, 2)
  grossProfit  Decimal @default(0) @db.Decimal(18, 2)

  cashAmount         Decimal @default(0) @db.Decimal(18, 2)
  cardAmount         Decimal @default(0) @db.Decimal(18, 2)
  qrAmount           Decimal @default(0) @db.Decimal(18, 2)
  bankTransferAmount Decimal @default(0) @db.Decimal(18, 2)
  otherAmount        Decimal @default(0) @db.Decimal(18, 2)

  createdById String
  cancelledAt DateTime?
  cancelNote  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy User       @relation("SaleBatchCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items     SaleItem[]

  @@index([date])
  @@index([status, date])
}

model SaleItem {
  id          String  @id @default(cuid())
  saleBatchId String
  productId   String
  quantity    Decimal @db.Decimal(18, 3)
  unitPrice   Decimal @db.Decimal(18, 2)
  total       Decimal @db.Decimal(18, 2)
  /// Борлуулалт бүртгэсэн үеийн жорын өртөг — хойшид өөрчлөгдөхгүй.
  unitCost    Decimal @default(0) @db.Decimal(18, 4)
  totalCost   Decimal @default(0) @db.Decimal(18, 2)

  saleBatch SaleBatch @relation(fields: [saleBatchId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleBatchId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Нөөцийн хөдөлгөөний дэвтэр
// ---------------------------------------------------------------------------

/// Нөөцийн ганц дэвтэр. Түүхий эд БОЛОН дамжуулан борлуулах
/// бүтээгдэхүүн хоёулаа энд бүртгэгдэнэ — rawMaterialId эсвэл
/// productId-ийн ЯГ НЭГ нь заавал утгатай (DB CHECK-ээр баталгаажсан).
model InventoryMovement {
  id            String       @id @default(cuid())
  rawMaterialId String?
  productId     String?
  movementType  MovementType
  /// Тэмдэгтэй хэмжээ: орлого эерэг, зарлага сөрөг (материалын үндсэн нэгжээр).
  quantity      Decimal      @db.Decimal(18, 3)
  unitCost      Decimal      @default(0) @db.Decimal(18, 4)
  /// quantity * unitCost — мөн адил тэмдэгтэй.
  totalCost     Decimal      @default(0) @db.Decimal(18, 2)
  /// Хөдөлгөөний дараах үлдэгдэл.
  balanceAfter  Decimal      @default(0) @db.Decimal(18, 3)

  referenceType String
  referenceId   String?
  note          String?

  createdById String
  createdAt   DateTime @default(now())

  rawMaterial RawMaterial? @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)
  product     Product?     @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy   User         @relation("MovementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([rawMaterialId, createdAt])
  @@index([productId, createdAt])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Тооллого
// ---------------------------------------------------------------------------

model InventoryCount {
  id          String    @id @default(cuid())
  countNo     String    @unique
  date        DateTime
  status      DocStatus @default(DRAFT)
  note        String?
  createdById String
  completedAt DateTime?
  cancelNote  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy User                 @relation("CountCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items     InventoryCountItem[]

  @@index([status, date])
}

model InventoryCountItem {
  id                  String  @id @default(cuid())
  countId             String
  rawMaterialId       String
  systemQuantity      Decimal @default(0) @db.Decimal(18, 3)
  countedQuantity     Decimal @default(0) @db.Decimal(18, 3)
  differenceQuantity  Decimal @default(0) @db.Decimal(18, 3)
  weightedAverageCost Decimal @default(0) @db.Decimal(18, 4)
  varianceAmount      Decimal @default(0) @db.Decimal(18, 2)

  count       InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  rawMaterial RawMaterial    @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)

  @@unique([countId, rawMaterialId])
  @@index([rawMaterialId])
}

// ---------------------------------------------------------------------------
// Зардал
// ---------------------------------------------------------------------------

model ExpenseCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]
}

model Expense {
  id          String    @id @default(cuid())
  date        DateTime
  categoryId  String
  amount      Decimal   @db.Decimal(18, 2)
  account     Account   @default(CASH)
  description String?
  receiptUrl  String?
  status      DocStatus @default(POSTED)

  createdById String
  cancelledAt DateTime?
  cancelNote  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category  ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy User            @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([date])
  @@index([status, date])
  @@index([categoryId])
}

// ---------------------------------------------------------------------------
// Мөнгөн гүйлгээний дэвтэр
// ---------------------------------------------------------------------------

model MoneyTransaction {
  id                 String               @id @default(cuid())
  type               MoneyTransactionType
  amount             Decimal              @db.Decimal(18, 2)
  sourceAccount      Account?
  destinationAccount Account?
  referenceType      String
  referenceId        String?
  note               String?

  createdById String
  createdAt   DateTime @default(now())
  occurredAt  DateTime @default(now())

  createdBy User @relation("MoneyTxnCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([occurredAt])
  @@index([type, occurredAt])
  @@index([referenceType, referenceId])
}

// ---------------------------------------------------------------------------
// Аудит ба тохиргоо
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  note       String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([userId, createdAt])
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
