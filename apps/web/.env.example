# PostgreSQL холболт
DATABASE_URL="postgresql://postgres:123456@localhost:5432/nachinerp?schema=public"

# Тайлан, өдрийн тооцоо гаргах цагийн бүсийн зөрүү (Улаанбаатар = 8).
# Тохируулаагүй бол 8 гэж үзнэ.
APP_TIMEZONE_OFFSET_HOURS=8

# Худалдан авалтын хавсралт хадгалах сан.
# Тохируулаагүй бол ажиллаж буй сангийн доор .storage/attachments үүснэ.
# ATTACHMENT_STORAGE_DIR=/var/lib/nachinerp/attachments
